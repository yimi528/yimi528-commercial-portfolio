+import { DoaiService } from './doai.service'
+import { registrationTeamBinding } from './doai-registration-team'
+
+const actor = { id: 'owner' }
+const member = { id: 'owner', name: 'Leader', phone: '', roleTitle: '队长', isLeader: true }
+const draft = { channel: 'public', expectedUserId: 'owner', requestKey: 'create-request-1', type: 'team', teamName: 'Shared Team', track: 'creator', projectName: 'Project', projectSummary: 'Private summary', videoUrl: '', docUrl: '', members: [member], teamBinding: { kind: 'create' } }
+function setup() {
+  const rows: any = { teams: [], members: [], registrations: [], tickets: [], requests: [], notices: [] }
+  const by = (items: any[], where: any) => items.find(row => Object.entries(Object.values(where)[0] as any).every(([k, v]) => row[k] === v)) || null
+  const create = (items: any[], extra = {}) => jest.fn(async ({ data }: any) => { const row = { ...data, createdAt: new Date(), ...extra }; items.push(row); return row })
+  const db: any = {
+    user: { findUnique: jest.fn(async ({ where }: any) => ({ id: where.id, name: where.id === 'owner' ? 'Leader' : 'Peer', phone: '' })), findMany: jest.fn(async ({ where }: any) => where.id.in.map((id: string) => ({ id, name: id === 'owner' ? 'Leader' : 'Peer' }))) },
+    doaiTeam: { findUnique: jest.fn(async ({ where }: any) => rows.teams.find((v: any) => v.id === where.id) || null), create: create(rows.teams) },
+    doaiTeamMember: { findUnique: jest.fn(async ({ where }: any) => by(rows.members, where)), findMany: jest.fn(async ({ where }: any) => rows.members.filter((v: any) => v.teamId === where.teamId && v.eventId === where.eventId)), create: create(rows.members) },
+    doaiRegistration: { create: create(rows.registrations, { status: 'submitted' }), findUnique: jest.fn(async ({ where }: any) => rows.registrations.find((v: any) => v.id === where.id)) },
+    doaiTicket: { create: create(rows.tickets, { status: 'claimed' }), findUnique: jest.fn(async ({ where }: any) => by(rows.tickets, where)) },
+    doaiRegistrationRequest: { create: create(rows.requests), findUnique: jest.fn(async ({ where }: any) => by(rows.requests, where)) },
+    doaiNotification: { create: create(rows.notices) },
+  }
+  db.$transaction = jest.fn(async (work: any) => work(db))
+  return { db, rows, service: new DoaiService(db) }
+}
+function existing(fixture: ReturnType<typeof setup>) {
+  fixture.rows.teams.push({ id: 'team', eventId: 'doai-2026', leaderId: 'owner', name: 'Shared Team', track: 'creator' })
+  fixture.rows.members.push({ userId: 'owner', teamId: 'team', eventId: 'doai-2026', roleTitle: '队长', isLeader: true }, { userId: 'peer', teamId: 'team', eventId: 'doai-2026', roleTitle: '研发', isLeader: false })
+  return { ...draft, teamBinding: { kind: 'existing', id: 'team' }, members: [member, { id: 'peer', name: 'Peer', phone: '', roleTitle: '研发', isLeader: false }] }
+}
+const rejected = async (work: Promise<any>, status: number) => expect(work).rejects.toMatchObject({ status })
+describe('registration and My Team share one confirmed team', () => {
+  it('creates one real team and deduplicates the equivalent existing-team intent after reload', async () => {
+    const { service, rows } = setup()
+    const first = await service.register(draft, actor)
+    expect(first.registration.teamId).toBe(rows.teams[0].id)
+    expect((await service.myTeam(actor)).team?.id).toBe(first.registration.teamId)
+    const retry = await service.register(draft, actor)
+    const afterReload = await service.register({ ...draft, requestKey: 'existing-request-2', teamBinding: { kind: 'existing', id: first.registration.teamId } }, actor)
+    expect(retry.registration.id).toBe(first.registration.id)
+    expect(afterReload.registration.id).toBe(first.registration.id)
+    expect(rows.teams).toHaveLength(1); expect(rows.members).toHaveLength(1)
+    expect(rows.registrations).toHaveLength(1); expect(rows.tickets).toHaveLength(1); expect(rows.notices).toHaveLength(1)
+    const capability = await service.registrationRequest('capability-request', actor)
+    expect(capability).toMatchObject({ found: false, teamPolicy: 'linked-v1' })
+  })
+  it('uses only the confirmed roster and leaves the live team untouched', async () => {
+    const fixture = setup(), body = existing(fixture)
+    const result = await fixture.service.register(body, actor)
+    expect(result.registration.teamId).toBe('team')
+    expect(result.registration.members.map((m: any) => m.id)).toEqual(['owner', 'peer'])
+    expect(fixture.db.doaiTeam.create).not.toHaveBeenCalled()
+    expect(fixture.db.doaiTeamMember.create).not.toHaveBeenCalled()
+  })
+  it('rejects forged peers, unconfirmed phones, stale names, tracks and non-leader submission before writes', async () => {
+    for (const change of [
+      { members: [member, { id: 'intruder', name: 'Peer', phone: '', roleTitle: '研发', isLeader: false }] },
+      { members: [member, { id: 'peer', name: 'Peer', phone: '13900000000', roleTitle: '研发', isLeader: false }] },
+      { teamName: 'Changed locally' }, { track: 'industry' }, { teamBinding: { kind: 'existing', id: 'other-team' } },
+    ]) {
+      const fixture = setup(), body = existing(fixture)
+      await rejected(fixture.service.register({ ...body, ...change }, actor), 409)
+      expect(fixture.rows.registrations).toHaveLength(0); expect(fixture.rows.requests).toHaveLength(0)
+    }
+    const fixture = setup(), body = existing(fixture)
+    await rejected(fixture.service.register({ ...body, expectedUserId: 'peer' }, { id: 'peer' }), 403)
+    expect(fixture.rows.registrations).toHaveLength(0)
+  })
+  it('does not create a second team or turn manually entered people into members', async () => {
+    const fixture = setup(); existing(fixture)
+    await rejected(fixture.service.register(draft, actor), 409)
+    const other = setup()
+    await rejected(other.service.register({ ...draft, members: [member, { id: 'm-123', name: 'Unconfirmed', isLeader: false }] }, actor), 409)
+    expect(other.rows.teams).toHaveLength(0); expect(other.rows.members).toHaveLength(0)
+    await rejected(other.service.register({ ...draft, type: 'individual' }, actor), 400)
+  })
+  it('validates binding input and keeps existing unlinked registration content compatible', () => {
+    for (const value of [null, [], 'team', { kind: 'create', id: 'team' }, { kind: 'existing', id: '../team' }]) expect(() => registrationTeamBinding(value)).toThrow()
+    expect(registrationTeamBinding(undefined)).toBeUndefined()
+  })
+})
