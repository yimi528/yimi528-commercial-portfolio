+++ b/src/common/doai-actor.ts
@@ -0,0 +1,58 @@
+import { HttpException } from '@nestjs/common'
+
+function reject(message: string, status: number, code: string): never {
+  throw new HttpException({ error: { code, message } }, status)
+}
+export const DOAI_ACTOR_HEADER = 'x-doai-actor'
+export function checkDoaiActor(req: any, path: string, method: string) {
+  const actor = req.headers?.[DOAI_ACTOR_HEADER]
+  if (
+    actor === undefined ||
+    (!path.startsWith('/doai/') && path !== '/auth/logout')
+  )
+    return
+  if (
+    typeof actor !== 'string' ||
+    !actor ||
+    actor.length > 64 ||
+    actor.trim() !== actor
+  )
+    reject('账号校验信息无效', 400, 'DOAI_ACTOR_INVALID')
+  if (
+    method === 'GET' &&
+    [
+      '/doai/health',
+      '/doai/site-config',
+      '/doai/forum-stats',
+      '/doai/forums',
+      '/doai/users',
+      '/doai/teams',
+      '/doai/wx-articles',
+    ].includes(path)
+  )
+    return
+  const publicPersonalized =
+    method === 'GET' &&
+    (/^\/doai\/recruitments(?:\/[^/]+)?$/.test(path) ||
+      path === '/doai/talents')
+  if (actor === '__anonymous__' || actor === '__pending__') {
+    if (publicPersonalized) {
+      req.userId = undefined
+      return
+    }
+    reject(
+      '请先确认登录账号',
+      actor === '__pending__' ? 409 : 401,
+      actor === '__pending__'
+        ? 'DOAI_SESSION_CHECKING'
+        : 'DOAI_SESSION_EXPIRED',
+    )
+  }
+  if (!req.userId) reject('登录已过期，请重新登录', 401, 'DOAI_SESSION_EXPIRED')
+  if (req.userId !== actor)
+    reject(
+      '登录账号已变化，本次操作未执行，请确认账号后重试',
+      409,
+      'DOAI_SESSION_CHANGED',
+    )
+}
