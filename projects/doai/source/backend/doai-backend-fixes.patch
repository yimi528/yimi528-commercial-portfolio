+++ b/src/modules/doai-registration-team.ts
@@ -0,0 +1,53 @@
+import { HttpException } from '@nestjs/common'
+import { randomUUID } from 'node:crypto'
+import type { Prisma } from '@prisma/client'
+import { registrationContentKey } from './doai-registration-content'
+
+type Data = Record<string, any>
+export type RegistrationTeamBinding = { kind: 'create' } | { kind: 'existing'; id: string }
+const EVENT = 'doai-2026'
+function fail(message: string, status = 409): never {
+  throw new HttpException({ error: { code: 'DOAI_TEAM_CHANGED', message } }, status)
+}
+export function registrationTeamBinding(value: unknown): RegistrationTeamBinding | undefined {
+  if (value === undefined) return undefined
+  if (!value || typeof value !== 'object' || Array.isArray(value)) fail('战队关联信息无效', 400)
+  const input = value as Data
+  if (input.kind === 'create' && input.id === undefined) return { kind: 'create' }
+  if (input.kind === 'existing' && typeof input.id === 'string' && /^[a-zA-Z0-9_-]{1,36}$/.test(input.id)) return { kind: 'existing', id: input.id }
+  fail('战队关联信息无效', 400)
+}
+
+/** Runs inside the registration transaction; manual names never become members. */
+export async function bindRegistrationTeam(db: Prisma.TransactionClient, uid: string, draft: Data, binding: RegistrationTeamBinding) {
+  if (draft.type !== 'team') fail('个人报名不能关联战队', 400)
+  const membership = await db.doaiTeamMember.findUnique({ where: { eventId_userId: { eventId: EVENT, userId: uid } } })
+  let team: { id: string; name: string; track: string; leaderId: string; eventId: string }
+  let roster: Data[]
+  if (binding.kind === 'existing') {
+    if (!membership || membership.teamId !== binding.id) fail('战队已变化，请重新加载战队后报名')
+    const saved = await db.doaiTeam.findUnique({ where: { id: binding.id } })
+    if (!saved || saved.eventId !== EVENT) fail('战队不存在或已解散，请重新加载战队')
+    if (saved.leaderId !== uid || !membership.isLeader) fail('团队报名须由战队队长提交', 403)
+    team = saved
+    const members = await db.doaiTeamMember.findMany({ where: { teamId: saved.id, eventId: EVENT }, orderBy: { createdAt: 'asc' } })
+    if (!members.length || members.length > 5 || new Set(members.map(m => m.userId)).size !== members.length
+      || members.filter(m => m.isLeader).length !== 1 || !members.some(m => m.isLeader && m.userId === uid)) fail('战队成员状态异常，请重新加载战队')
+    const users = await db.user.findMany({ where: { id: { in: members.map(m => m.userId) } }, select: { id: true, name: true } })
+    roster = members.map(m => ({ id: m.userId, name: m.isLeader ? draft.members.find((v: Data) => v.isLeader)?.name : users.find(u => u.id === m.userId)?.name,
+      phone: '', roleTitle: m.roleTitle, isLeader: m.isLeader }))
+    if (roster.some(m => !m.name)) fail('战队成员资料不完整，请重新加载战队')
+  } else {
+    if (membership) fail('你已有战队，请重新加载并使用已有战队报名')
+    team = { id: randomUUID(), name: draft.teamName, track: draft.track, leaderId: uid, eventId: EVENT }
+    roster = [{ id: uid, name: draft.members.find((v: Data) => v.isLeader)?.name, phone: '', roleTitle: '队长', isLeader: true }]
+  }
+  if (draft.track !== team.track) fail('报名赛道与战队赛道不一致，请使用战队所属赛道')
+  const expected = { ...draft, teamName: team.name, members: roster }
+  if (registrationContentKey(expected, uid) !== registrationContentKey(draft, uid)) fail('队名或成员已变化，请重新加载战队；队员须先接受入队邀请')
+  if (binding.kind === 'create') {
+    await db.doaiTeam.create({ data: { ...team, inviteCode: randomUUID().replace(/-/g, '') } })
+    await db.doaiTeamMember.create({ data: { id: randomUUID(), teamId: team.id, userId: uid, eventId: EVENT, isLeader: true, roleTitle: '队长' } })
+  }
+  return { teamId: team.id, teamBinding: binding }
+}
