@@ -0,0 +1,162 @@
+import { Controller, Get, Post, Req, Res } from '@nestjs/common'
+import { APP_GUARD } from '@nestjs/core'
+import { Test } from '@nestjs/testing'
+import type { INestApplication } from '@nestjs/common'
+import cookieParser from 'cookie-parser'
+import request from 'supertest'
+import { AuthGuard } from './auth.guard'
+import { AtomAuthService } from './atom-auth.service'
+import { TaskService } from '../modules/task.service'
+
+let mutations = 0
+@Controller()
+class ActorProbeController {
+  @Post('doai/tickets') create(@Req() req: any) {
+    mutations++
+    return { owner: req.userId }
+  }
+  @Get('doai/me') identity(@Req() req: any) {
+    return { owner: req.userId }
+  }
+  @Get('doai/tickets') privateRead(@Req() req: any) {
+    return { owner: req.userId }
+  }
+  @Get('doai/recruitments') publicFeed(@Req() req: any) {
+    return { owner: req.userId ?? null }
+  }
+  @Get('doai/forum-stats') publicStats() {
+    return { count: 18 }
+  }
+  @Post('auth/logout') logout(
+    @Req() req: any,
+    @Res({ passthrough: true }) res: any,
+  ) {
+    mutations++
+    res.clearCookie('sid')
+    return { owner: req.userId }
+  }
+}
+describe('DOAI expected actor is checked before HTTP handlers and logout cookies', () => {
+  let app: INestApplication
+  const tasks = { maybeRecordLoginStreak: jest.fn(async () => undefined) }
+  const auth = {
+    verify: jest.fn(async (token: string) =>
+      token === 'qa-a' || token === 'qa-a-cookie'
+        ? { valid: true, hubUserId: 'a' }
+        : token === 'qa-b'
+          ? { valid: true, hubUserId: 'b' }
+          : { valid: false },
+    ),
+  }
+  beforeAll(async () => {
+    const module = await Test.createTestingModule({
+      controllers: [ActorProbeController],
+      providers: [
+        { provide: APP_GUARD, useClass: AuthGuard },
+        { provide: AtomAuthService, useValue: auth },
+        { provide: TaskService, useValue: tasks },
+      ],
+    }).compile()
+    app = module.createNestApplication()
+    app.setGlobalPrefix('api')
+    app.use(cookieParser())
+    await app.listen(0, '127.0.0.1')
+  })
+  afterAll(async () => {
+    await app.close()
+  })
+  beforeEach(() => {
+    mutations = 0
+    tasks.maybeRecordLoginStreak.mockClear()
+  })
+  it('rejects a stale displayed actor before any write or streak update', async () => {
+    const result = await request(app.getHttpServer())
+      .post('/api/doai/tickets')
+      .set('Authorization', 'Bearer qa-b')
+      .set('X-DOAI-Actor', 'a')
+      .send({ userId: 'a' })
+      .expect(409)
+    expect(result.body.error.code).toBe('DOAI_SESSION_CHANGED')
+    expect(mutations).toBe(0)
+    expect(tasks.maybeRecordLoginStreak).not.toHaveBeenCalled()
+  })
+  it('cannot use the actor header to authenticate and accepts the actual matching principal', async () => {
+    await request(app.getHttpServer())
+      .post('/api/doai/tickets')
+      .set('X-DOAI-Actor', 'a')
+      .send({})
+      .expect(401)
+    const result = await request(app.getHttpServer())
+      .post('/api/doai/tickets')
+      .set('Authorization', 'Bearer qa-a')
+      .set('X-DOAI-Actor', 'a')
+      .send({ userId: 'b' })
+      .expect(201)
+    expect(result.body.owner).toBe('a')
+    expect(mutations).toBe(1)
+  })
+  it('scopes private cookie reads and strips personalized flags for an unconfirmed public reader', async () => {
+    await request(app.getHttpServer())
+      .get('/api/doai/tickets')
+      .set('Cookie', 'sid=qa-b')
+      .set('X-DOAI-Actor', 'a')
+      .expect(409)
+    const result = await request(app.getHttpServer())
+      .get('/api/doai/recruitments')
+      .set('Cookie', 'sid=qa-b')
+      .set('X-DOAI-Actor', '__anonymous__')
+      .expect(200)
+    expect(result.body.owner).toBe(null)
+    await request(app.getHttpServer())
+      .get('/api/doai/me')
+      .set('Cookie', 'sid=qa-b')
+      .set('X-DOAI-Actor', 'a')
+      .expect(409)
+    await request(app.getHttpServer())
+      .get('/api/doai/me')
+      .set('Cookie', 'sid=qa-b')
+      .set('X-DOAI-Actor', 'b')
+      .expect(200)
+    await request(app.getHttpServer())
+      .get('/api/doai/forum-stats')
+      .set('X-DOAI-Actor', '__pending__')
+      .expect(200)
+  })
+  it('does not clear a newer account cookie from a stale logout', async () => {
+    const result = await request(app.getHttpServer())
+      .post('/api/auth/logout')
+      .set('Authorization', 'Bearer qa-a')
+      .set('Cookie', 'sid=qa-b')
+      .set('X-DOAI-Actor', 'a')
+      .send({})
+      .expect(409)
+    expect(result.headers['set-cookie']).toBeUndefined()
+    expect(mutations).toBe(0)
+    await request(app.getHttpServer())
+      .post('/api/auth/logout/')
+      .set('Authorization', 'Bearer qa-a')
+      .set('Cookie', 'sid=qa-b')
+      .set('X-DOAI-Actor', 'a')
+      .send({})
+      .expect(409)
+  })
+  it('allows the same account cookie to finish logout if its old bearer expired', async () => {
+    const result = await request(app.getHttpServer())
+      .post('/api/auth/logout')
+      .set('Authorization', 'Bearer expired')
+      .set('Cookie', 'sid=qa-a-cookie')
+      .set('X-DOAI-Actor', 'a')
+      .send({})
+      .expect(201)
+    expect(result.body.owner).toBe('a')
+    expect(result.headers['set-cookie']).toBeDefined()
+  })
+  it('preserves existing authenticated callers without the new header', async () => {
+    const result = await request(app.getHttpServer())
+      .post('/api/doai/tickets')
+      .set('Authorization', 'Bearer qa-b')
+      .send({})
+      .expect(201)
+    expect(result.body.owner).toBe('b')
+  })
+})
