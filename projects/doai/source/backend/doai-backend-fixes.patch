+      if (!profile || !profile.isPublic) fail('达人名片不存在或未公开', 404)
+      const existing = await db.doaiProfileLike.findUnique({ where: { profileUserId_userId: { profileUserId, userId: uid } } })
+      const liked = body.liked === undefined ? !existing : body.liked
+      if (!liked && existing) await db.doaiProfileLike.delete({ where: { id: existing.id } })
+      else if (liked && !existing) await db.doaiProfileLike.create({ data: { id: randomUUID(), profileUserId, userId: uid } })
+      const likes = await db.doaiProfileLike.count({ where: { profileUserId } })
+      await db.doaiProfile.update({ where: { userId: profileUserId }, data: { likes } })
+      return { ok: true, hasLiked: liked, likes }
+    })
+  }
+
+  /* --------------------------- 首页 CMS 配置 --------------------------- */
+
+  /**
+   * 首页关键指标与公告。整块存 JSON：读公开（首页首屏就要用），写只允许
+   * DOAI_ADMIN_USER_IDS 白名单，字段在这里逐项校验后再落库，避免塞入任意结构。
+   */
+  private homeConfig(body: Data) {
+    const stats = object(body.stats)
+    const count = (value: unknown, max: number) => {
+      if (typeof value !== 'number' || !Number.isInteger(value) || value < 0 || value > max) fail('指标须为范围内不小于 0 的整数')
+      return value
+    }
+    return {
+      stats: {
+        makers: count(stats.makers, 1000000), finalistProjects: count(stats.finalistProjects, 1000000),
+        prizePool: text(stats.prizePool, 32), prizePoolEn: text(stats.prizePoolEn, 32), judges: count(stats.judges, 1000000),
+      },
+      announcement: text(body.announcement, 500), announcementEn: text(body.announcementEn, 500), streamUrl: url(body.streamUrl),
+    }
+  }
+
+  async siteConfig() {
+    const row = await this.db.doaiSiteConfig.findUnique({ where: { key: SITE_CONFIG_KEY } })
+    return { ok: true, config: row?.value ?? null, updatedAt: row?.updatedAt ?? null }
+  }
+
+  async saveSiteConfig(body: Data, user?: RequestUser) {
+    const updatedBy = await this.admin(user)
+    const config = this.homeConfig(object(body.config))
+    if (body.expectedUpdatedAt === undefined) fail('请先重新读取当前配置再保存', 409)
+    const expected = body.expectedUpdatedAt === null ? null : new Date(text(body.expectedUpdatedAt, 64, true))
+    if (expected && !Number.isFinite(expected.getTime())) fail('配置版本无效')
+    const value = config as unknown as Prisma.InputJsonValue
+    try {
+      return await this.tx(async db => {
+        const current = await db.doaiSiteConfig.findUnique({ where: { key: SITE_CONFIG_KEY } })
+        if (!current) {
+          if (expected !== null) fail('配置已变更，请重新加载最新配置', 409)
+          const row = await db.doaiSiteConfig.create({ data: { key: SITE_CONFIG_KEY, value, updatedBy } })
+          return { ok: true, config: row.value, updatedAt: row.updatedAt }
+        }
+        if (!expected || current.updatedAt.getTime() !== expected.getTime()) fail('配置已被其他管理员修改，请重新加载最新配置', 409)
+        const updatedAt = new Date(Math.max(Date.now(), current.updatedAt.getTime() + 1))
+        const result = await db.doaiSiteConfig.updateMany({ where: { key: SITE_CONFIG_KEY, updatedAt: expected }, data: { value, updatedBy, updatedAt } })
+        if (result.count !== 1) fail('配置已被其他管理员修改，请重新加载最新配置', 409)
+        return { ok: true, config, updatedAt }
+      })
+    } catch (error) {
+      if (error instanceof Prisma.PrismaClientKnownRequestError && error.code === 'P2002') fail('配置已被其他管理员创建，请重新加载最新配置', 409)
+      throw error
+    }
   }
 
