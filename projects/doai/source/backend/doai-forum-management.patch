+    expect(result.ticket.venue).toBe(forum.venue)
+    db.doaiTicket.findUnique.mockResolvedValue({...result.ticket,eventId:'doai-2026',status:'claimed',details:{startsAt:forum.startsAt,endsAt:forum.endsAt}})
+    db.doaiTicket.updateMany.mockResolvedValue({count:1})
+    expect((await service.cancelTicket(result.ticket.id,actor)).ok).toBe(true)
+  })
+})
